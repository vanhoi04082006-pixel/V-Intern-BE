{
  "name": "v-intern-be",
  "version": "0.1.0",
  "description": "V-INTERN learning platform API: NestJS, SQL Server, recruitment, sessions, GitHub and AI review",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:career-roles:migration": "jest --config test/jest-e2e.json --runInBand --testRegex=career-role-migration.sql-spec.ts$",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "bootstrap:admin": "ts-node src/scripts/bootstrap-admin.ts",
    "seed:dev": "ts-node src/scripts/seed-dev.ts",
    "db:create:e2e": "ts-node src/scripts/create-e2e-database.ts",
    "audit:schema": "ts-node src/scripts/audit-schema.ts",
    "seed:recruitment": "ts-node src/scripts/seed-recruitment-questions.ts",
    "seed:library": "ts-node src/scripts/seed-learning-library.ts",
    "seed:mini-projects": "ts-node src/scripts/seed-mini-projects.ts",
    "export:mini-knowledge": "ts-node src/scripts/export-mini-knowledge.ts",
    "seed:g2-content": "ts-node src/scripts/seed-g2-content.ts"
  },
  "dependencies": {
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint": "1.2.1",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "langchain": "1.5.19",
    "langsmith": "0.11.1",
    "mssql": "^11.0.1",
    "nodemailer": "10.2.1",
    "pdfkit": "^0.15.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/exceljs": "^1.3.2",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "uuid": "11.1.1",
    "body-parser": "2.4.0",
    "multer": "2.5.0",
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
