# V-Intern-BE — environment template
# Copy to `.env` and fill real values. NEVER commit the real `.env`.

NODE_ENV=development
PORT=8080

# ── Microsoft SQL Server 2019 ────────────────────────────────────────────────
# Local dev commonly uses encrypt=false + trustServerCertificate=true.
# Production MUST use secure TLS (DB_ENCRYPT=true, trusted certificate chain).
DB_HOST=localhost
DB_PORT=1433
DB_NAME=VIntern
DB_USERNAME=vintern_app
DB_PASSWORD=change-me-strong
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ── Auth ─────────────────────────────────────────────────────────────────────
# JWT_SECRET must be >= 32 chars, random, per-environment. Rotate on suspicion.
JWT_SECRET=change-me-min-32-chars-random-secret!!!!!!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# ── CORS (comma-separated allowlist; wildcard + credentials is forbidden) ───
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ── Rate limiting (per-process, in-memory; see README limitations) ──────────
THROTTLE_LIMIT_PER_MIN=100
THROTTLE_AUTH_PER_MIN=10

# ── Phase 4 — AI provider (spec 23/25/26) ───────────────────────────────────
# AI is OPTIONAL: unset = every AI call fails honestly (AI_PROVIDER_UNAVAILABLE).
# Production NEVER falls back to fake scores. The key is server-only.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# ── Phase 4 — recruitment policy (spec 14/18/19) ────────────────────────────
RECRUITMENT_INTERVIEW_DURATION_MINUTES=30
RECRUITMENT_MAX_ATTEMPTS=3
RECRUITMENT_RETAKE_COOLDOWN_HOURS=24

# ── Phase 4 — interview/AI rate limits per user per minute (spec 56) ───────
THROTTLE_INTERVIEW_START_PER_MIN=5
THROTTLE_INTERVIEW_SUBMIT_PER_MIN=6
THROTTLE_EVALUATION_PER_MIN=3
THROTTLE_AI_GENERATION_PER_MIN=4
THROTTLE_INTERVIEW_CHAT_PER_MIN=15

# GitHub OAuth: each instructor owns their session repositories.
# Register the exact callback URL in your GitHub OAuth App.
FRONTEND_ORIGIN=http://localhost:3001
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/github/callback
# Dedicated base64-encoded 32-byte encryption key, never JWT_SECRET.
GITHUB_TOKEN_ENCRYPTION_KEY=

# External isolated trusted-test runner (see docs/architecture/grading-runner.md).
# Leave unset until an actual sandbox and reviewed suites are deployed.
GRADING_RUNNER_URL=
GRADING_RUNNER_TOKEN=
GRADING_RUNNER_SIGNING_KEY=
# Map "TEMPLATE-CODE:task-uuid" to {id,digest}; generate with grading-runner/prepare-catalog.mjs.
GRADING_SUITES_JSON={}

# GitHub sends signed events to this public HTTPS endpoint. Keep the secret server-side.
# GITHUB_WEBHOOK_URL=https://your-api.example.com/api/v1/github/webhook
GITHUB_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=

# ── Bootstrap initial admin (CLI: npm run bootstrap:admin) ──────────────────
# Password minimum 10 chars. The CLI is idempotent and refuses weak passwords.
BOOTSTRAP_ADMIN_EMAIL=admin@vintern.edu.vn
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Admin

# ── E2E tests (optional, explicit isolation) ────────────────────────────────
# E2E refuses to run unless E2E_DB_NAME points to a DISPOSABLE database.
E2E_DB_NAME=
